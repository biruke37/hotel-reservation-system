generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  CONFIRMED
  REJECTED
}

enum PaymentMethod {
  TELEBIRR
  CBE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String?
  role      Role      @default(CUSTOMER)
  gender    String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Room {
  id            String    @id @default(cuid())
  roomNumber    String    @unique
  type          String
  pricePerNight Float
  title         String? // ? መጨመር
  description   String
  category      String? // ? መጨመር
  images        String[]
  amenities     String
  isAvailable   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  bookings      Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hotelName String        @default("Hotel")
  nights    Int           @default(1)
  amount    Float
  status    BookingStatus @default(PENDING_PAYMENT)
  payment   Payment?
  createdAt DateTime      @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod
  transactionId String        @unique
  receiptUrl    String
  status        PaymentStatus @default(PENDING)
  adminNotes    String?
  createdAt     DateTime      @default(now())
}
